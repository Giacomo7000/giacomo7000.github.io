---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ArchiveCard from "@components/ArchiveCard.astro";
import GMLogo from "@components/GMLogo.astro";
import { site } from "@data/site";
import { getFeaturedProjects, getArchiveEntries } from "@lib/content";
import { t, localizedPath } from "@lib/i18n";

const lang = "en";
const projects = await getFeaturedProjects();
const archive = (await getArchiveEntries()).slice(0, 3);
---

<BaseLayout lang={lang} title={site.role[lang]} path="/">
  <section class="hero container">
    <div class="hero-copy reveal">
      <p class="eyebrow">{site.role[lang]}</p>
      <h1>Giacomo Mariuzza</h1>
      <p class="lead">I build AI-powered software and help businesses turn complex needs into practical solutions, combining hands-on development, technical expertise, and client-focused consulting.</p>
      <div class="button-row">
        <Button href="/projects">{t(lang, "viewProjects")}</Button>
        <Button href="/contact" variant="secondary">{t(lang, "contactMe")}</Button>
        <Button href={site.cvPath[lang]} variant="secondary">{t(lang, "viewCv")}</Button>
      </div>
    </div>
    <div class="hero-mark reveal" aria-hidden="true">
      <GMLogo size={260} />
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <SectionHeading eyebrow="About" title="Where AI development meets real business needs." lead="I combine hands-on AI development with solutions consulting, from building intelligent applications and automation systems to understanding business challenges, assessing technical feasibility, and contributing to effective AI solutions." />
      <Button href="/about" variant="secondary">Read about me</Button>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Projects" title={t(lang, "featuredProjects")} lead="A selection of projects that show how I work: from idea to prototype, through to real and usable solutions." />
      <div class="grid grid-3">
        {projects.map((project) => (
          <ProjectCard
            project={project}
            lang={lang}
            descriptionField={project.slug === "bachelor-thesis-instagram-engagement" ? "subtitle" : "summary"}
          />
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Events" title={t(lang, "latestArchive")} lead="Notes, experiences, and moments that mark my path through the world of technology." />
      <div class="grid grid-3">
        {archive.map((entry) => <ArchiveCard entry={entry} lang={lang} />)}
      </div>
    </div>
  </section>
  <section class="section contact-band">
    <div class="container split">
      <SectionHeading eyebrow="Contact" title="Let’s turn ideas into AI-powered solutions." lead="Interested in AI development, technical consulting, or potential collaborations? Let’s connect." />
      <Button href={localizedPath(lang, "/contact")}>{t(lang, "contactMe")}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 38%);
    align-items: center;
    gap: clamp(34px, 7vw, 80px);
    min-height: calc(100vh - 70px);
    padding: 72px 0;
  }

  .hero-copy {
    display: grid;
    gap: 24px;
  }

  .hero-mark {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  .hero-mark :global(.gm-logo) {
    width: min(68%, 280px);
    height: auto;
    aspect-ratio: 1;
  }

  .split > :global(.button) { flex-shrink: 0; }

  .split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .contact-band {
    background: color-mix(in srgb, var(--surface) 58%, transparent);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 56px 0;
    }

    .hero-mark {
      max-width: 420px;
    }

    .split {
      display: grid;
      align-items: start;
    }
  }
  @media (max-width: 600px) {
    .hero { padding: 44px 0 48px; gap: 0; }
    .hero-copy { gap: 22px; }
    .hero-copy.reveal { opacity: 1; transform: none; }
    .hero h1 { font-size: clamp(2.6rem, 11vw, 3.8rem); }
    .hero-mark { display: none; }
    .button-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .button-row :global(.button:first-child) { grid-column: 1 / -1; }
    .split > :global(.button) { justify-self: start; }
  }
</style>
