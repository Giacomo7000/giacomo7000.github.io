---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ArchiveCard from "@components/ArchiveCard.astro";
import GMLogo from "@components/GMLogo.astro";
import { site } from "@data/site";
import { getFeaturedProjects, getArchiveEntries } from "@lib/content";
import { t, localizedPath } from "@lib/i18n";

const lang = "it";
const projects = await getFeaturedProjects();
const archive = (await getArchiveEntries()).slice(0, 3);
---

<BaseLayout lang={lang} title={site.role[lang]} path="/it">
  <section class="hero container">
    <div class="hero-copy reveal">
      <p class="eyebrow">{site.role[lang]}</p>
      <h1>Giacomo Mariuzza</h1>
      <p class="lead">Sviluppo software basati sull’AI e aiuto le aziende a trasformare esigenze complesse in soluzioni concrete, unendo sviluppo pratico, competenze tecniche e consulenza orientata al cliente.</p>
      <div class="button-row">
        <Button href="/it/projects">{t(lang, "viewProjects")}</Button>
        <Button href="/it/contact" variant="secondary">{t(lang, "contactMe")}</Button>
        <Button href={site.cvPath[lang]} variant="secondary">{t(lang, "viewCv")}</Button>
      </div>
    </div>
    <div class="hero-mark reveal" aria-hidden="true">
      <GMLogo size={260} />
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <SectionHeading eyebrow="Chi sono" title="Dove lo sviluppo AI incontra le reali esigenze delle aziende." lead="Unisco lo sviluppo di applicazioni intelligenti e sistemi di automazione alla consulenza sulle soluzioni AI: comprendo le sfide aziendali, valuto la fattibilità tecnica e contribuisco a realizzare soluzioni efficaci." />
      <Button href="/it/about" variant="secondary">Leggi di più</Button>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Progetti" title={t(lang, "featuredProjects")} lead="Una selezione di progetti che raccontano il mio modo di lavorare: dall'idea al prototipo, fino a soluzioni reali e utilizzabili." />
      <div class="grid grid-3">
        {projects.map((project) => (
          <ProjectCard
            project={project}
            lang={lang}
            descriptionField={project.slug === "bachelor-thesis-instagram-engagement" ? "subtitle" : "summary"}
          />
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Eventi" title={t(lang, "latestArchive")} lead="Appunti, esperienze e momenti che segnano il mio percorso nel mondo della tecnologia." />
      <div class="grid grid-3">
        {archive.map((entry) => <ArchiveCard entry={entry} lang={lang} />)}
      </div>
    </div>
  </section>
  <section class="section contact-band">
    <div class="container split">
      <SectionHeading eyebrow="Contatti" title="Trasformiamo le idee in soluzioni AI." lead="Vuoi parlare di sviluppo AI, consulenza tecnica o possibili collaborazioni? Mettiamoci in contatto." />
      <Button href={localizedPath(lang, "/contact")}>{t(lang, "contactMe")}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 38%);
    align-items: center;
    gap: clamp(34px, 7vw, 80px);
    min-height: calc(100vh - 70px);
    padding: 72px 0;
  }

  .hero-copy {
    display: grid;
    gap: 24px;
  }

  .hero-mark {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  .hero-mark :global(.gm-logo) {
    width: min(68%, 280px);
    height: auto;
    aspect-ratio: 1;
  }

  .split > :global(.button) { flex-shrink: 0; }

  .split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .contact-band {
    background: color-mix(in srgb, var(--surface) 58%, transparent);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 56px 0;
    }

    .hero-mark {
      max-width: 420px;
    }

    .split {
      display: grid;
      align-items: start;
    }
  }
  @media (max-width: 600px) {
    .hero { padding: 44px 0 48px; gap: 0; }
    .hero-copy { gap: 22px; }
    .hero-copy.reveal { opacity: 1; transform: none; }
    .hero h1 { font-size: clamp(2.6rem, 11vw, 3.8rem); }
    .hero-mark { display: none; }
    .button-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .button-row :global(.button:first-child) { grid-column: 1 / -1; }
    .split > :global(.button) { justify-self: start; }
  }
</style>
