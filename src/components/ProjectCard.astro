---
import type { CollectionEntry } from "astro:content";
import type { Lang } from "@data/site";
import { localize, localizedPath, t } from "@lib/i18n";
import { formatProjectDate } from "@lib/dates";

const { project, lang, descriptionField = "summary" } = Astro.props as {
  project: CollectionEntry<"projects">;
  lang: Lang;
  descriptionField?: "summary" | "subtitle";
};
const href = localizedPath(lang, `/projects/${project.slug}`);
const displayDate = formatProjectDate(project.data, lang);
const description = project.data[descriptionField];
---

<a class="project-card card reveal" href={href} aria-label={localize(project.data.title, lang)}>
  {project.data.cover && (
    <div class="cover">
      <img class:list={[project.data.coverFit === "logo" && "logo-cover"]} src={project.data.cover} alt="" loading="lazy" />
    </div>
  )}
  <div class="card-body">
    <div class="meta">
      <span>{displayDate}</span>
      <span>{localize(project.data.status, lang)}</span>
    </div>
    <h3>{localize(project.data.title, lang)}</h3>
    <p>{localize(description, lang)}</p>
    <div class="tag-row">
      {project.data.technologies.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}
    </div>
    <span class="text-link">{t(lang, "readMore")}</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition);
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
  }

  .cover {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--surface-strong);
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover img.logo-cover {
    width: 72%;
    height: 72%;
    margin: 0 auto;
    object-fit: contain;
  }

  .cover:has(.logo-cover) {
    display: grid;
    place-items: center;
    padding: 18px;
    background: color-mix(in srgb, var(--surface) 72%, var(--accent) 6%);
  }

  .card-body {
    display: grid;
    gap: 14px;
    padding: 20px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  p {
    color: var(--muted);
  }

  .text-link {
    width: fit-content;
    color: var(--accent);
    font-weight: 800;
  }
</style>
