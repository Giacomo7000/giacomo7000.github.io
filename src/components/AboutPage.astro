---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import Timeline from "@components/Timeline.astro";
import { about } from "@data/about";
import { site, type Lang } from "@data/site";
import { localizedPath, t } from "@lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const copy = about[lang];
---

<BaseLayout lang={lang} title={copy.title} path={localizedPath(lang, "/about")} description={copy.description}>
  <section class="about-hero container" aria-labelledby="about-title">
    <p class="eyebrow">{copy.title}</p>
    <div class="intro-grid">
      <h1 id="about-title">{copy.headline[0]} <span>{copy.headline[1]}</span></h1>
      <div class="intro-copy">
        <p class="lead">{copy.introduction}</p>
        <p>{copy.belief}</p>
      </div>
    </div>
    <div class="now-strip">
      <p class="now-label"><span aria-hidden="true"></span>{copy.now}</p>
      <dl class="now-details">
        <div>
          <dt>{copy.work}</dt>
          <dd><strong>AiperTech</strong><span>{copy.workDetail}</span></dd>
        </div>
        <div>
          <dt>{copy.study}</dt>
          <dd><strong>AI &amp; Cybersecurity</strong><span>{copy.studyDetail}</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="journey-title">
    <div class="container journey-grid">
      <div class="journey-intro">
        <p class="eyebrow">{copy.journey}</p>
        <h2 id="journey-title">{copy.journeyTitle}</h2>
        <p>{copy.journeyIntro}</p>
        <div><Button href={site.cvPath[lang]} variant="secondary">{t(lang, "viewCv")}</Button></div>
      </div>
      <div class="journey-timeline">
        <p class="timeline-caption">{copy.timelineOrder}</p>
        <Timeline lang={lang} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="method-title">
    <div class="container">
      <div class="section-intro reveal">
        <div>
          <p class="eyebrow">{copy.method}</p>
          <h2 id="method-title">{copy.methodTitle}</h2>
        </div>
        <p class="section-description">{copy.methodIntro}</p>
      </div>
      <ol class="principles" role="list">
        {copy.principles.map((principle, index) => (
          <li class="principle reveal">
            <span class="principle-number" aria-hidden="true">0{index + 1}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="focus-title">
    <div class="container">
      <div class="focus-heading reveal">
        <p class="eyebrow">{copy.focus}</p>
        <h2 id="focus-title">{copy.focusTitle}</h2>
      </div>
      <div class="interests">
        {copy.interests.map((interest, index) => (
          <article class="interest reveal">
            <div class="interest-top">
              <p class="eyebrow">{interest.label}</p>
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {index === 0 ? <><rect x="8" y="8" width="16" height="16" rx="4" /><path d="M13 13h6v6h-6zM12 4v4m8-4v4M12 24v4m8-4v4M4 12h4m-4 8h4m16-8h4m-4 8h4" /></> : <><rect x="7" y="3" width="18" height="26" rx="5" /><path d="M13 7h6M14 25h4M12 17l3 3 6-7" /></>}
              </svg>
            </div>
            <h3>{interest.title}</h3>
            <p>{interest.body}</p>
            <ul class="interest-tags" role="list">
              {interest.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="next-step reveal">
        <div><h3>{copy.next}</h3><p>{copy.nextIntro}</p></div>
        <Button href={localizedPath(lang, "/projects")} variant="secondary">{t(lang, "viewProjects")}<span class="link-arrow" aria-hidden="true">↗</span></Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero { padding-block: clamp(52px, 7vw, 88px) 0; }
  .about-hero > .eyebrow { margin-bottom: 26px; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr); align-items: end; gap: clamp(32px, 5vw, 72px); }
  h1 { font-size: clamp(2.65rem, 4.8vw, 4.6rem); line-height: 1.07; letter-spacing: -0.025em; text-wrap: balance; }
  h1 span { display: block; color: var(--accent); }
  .intro-copy { display: grid; gap: 20px; padding-bottom: 4px; }
  .intro-copy .lead { color: var(--text); font-size: clamp(1.12rem, 1.65vw, 1.28rem); }
  .intro-copy > p:last-child, .journey-intro > p:not(.eyebrow), .section-description, .principle p, .interest > p, .next-step p { color: var(--muted); }
  .now-strip { display: grid; grid-template-columns: 0.7fr 2.3fr; gap: 32px; align-items: start; margin-top: clamp(44px, 6vw, 72px); padding-block: 28px 34px; border-top: 1px solid var(--line); }
  .now-label { display: flex; align-items: center; gap: 10px; padding-top: 2px; color: var(--muted); font-size: 0.88rem; }
  .now-label > span { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--tag); }
  .now-details { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin: 0; }
  .now-details > div { padding-left: 24px; border-left: 1px solid var(--line); }
  dt { margin-bottom: 6px; color: var(--muted); font-size: 0.78rem; }
  dd { display: grid; gap: 2px; margin: 0; }
  dd strong { font-size: 1.05rem; font-weight: 600; }
  dd span { color: var(--muted); font-size: 0.85rem; }
  .journey-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(48px, 9vw, 120px); align-items: start; }
  .journey-intro { display: grid; gap: 24px; position: sticky; top: 110px; }
  .journey-intro .eyebrow { margin: 0; }
  h2 { letter-spacing: -0.02em; text-wrap: balance; }
  .journey-intro > p:not(.eyebrow) { max-width: 40ch; font-size: 1.05rem; }
  .timeline-caption { margin-bottom: 28px; color: var(--muted); font-size: 0.82rem; }
  .section-intro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); align-items: end; gap: 48px; margin-bottom: 48px; }
  .section-description { max-width: 38ch; }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; padding: 0; margin: 0; list-style: none; }
  .principle { display: grid; align-content: start; gap: 18px; border-top: 1px solid var(--line); padding-top: 22px; }
  .principle-number { color: var(--accent); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .principle h3 { font-size: 1.3rem; font-weight: 600; letter-spacing: -0.015em; }
  .focus-heading { max-width: 760px; margin-bottom: 36px; }
  .interests { display: grid; grid-template-columns: 1.12fr 1fr; gap: 20px; }
  .interest { display: flex; flex-direction: column; align-items: start; padding: clamp(24px, 3.2vw, 40px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); }
  .interest-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; margin-bottom: 28px; }
  .interest-top .eyebrow { margin: 0; font-size: 0.7rem; }
  .interest-top svg { flex-shrink: 0; width: 32px; height: 32px; color: var(--accent); }
  .interest h3 { font-family: var(--font-serif); font-size: clamp(1.65rem, 2.5vw, 2.25rem); font-weight: 620; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 18px; text-wrap: balance; }
  .interest > p { margin-bottom: 28px; }
  .interest-tags { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: auto 0 0; padding: 0; list-style: none; }
  .interest-tags li { color: var(--accent); font-size: 0.76rem; }
  .next-step { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: 48px; }
  .next-step h3 { margin-bottom: 8px; font-size: 1.2rem; }
  .link-arrow { margin-left: 12px; }
  @media (max-width: 960px) {
    .journey-intro { position: static; }
  }
  @media (max-width: 860px) {
    .intro-grid { grid-template-columns: 1fr; gap: 28px; }
    h1 { max-width: 720px; font-size: clamp(2.65rem, 6.5vw, 4.6rem); }
    .intro-copy { max-width: 620px; }
    .now-strip { grid-template-columns: 1fr; gap: 24px; }
    .now-details > div { padding-left: 0; border-left: 0; }
    .journey-grid { grid-template-columns: 1fr; gap: 40px; }
    .journey-intro { max-width: 620px; gap: 20px; }
    .journey-intro > p:not(.eyebrow) { max-width: none; }
    .section-intro { grid-template-columns: 1fr; gap: 20px; margin-bottom: 32px; }
    .section-description { max-width: 55ch; }
    .principles { gap: 24px; }
    .interests { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .about-hero { padding-top: 40px; }
    .about-hero > .eyebrow { margin-bottom: 22px; }
    h1 { font-size: clamp(2.35rem, 9.6vw, 3.5rem); line-height: 1.1; }
    .intro-copy { gap: 14px; }
    .now-strip { margin-top: 36px; padding-block: 24px 28px; gap: 20px; }
    .now-details { grid-template-columns: 1fr; gap: 20px; }
    .now-details > div { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 12px; align-items: baseline; }
    dt { margin: 0; }
    dd strong { font-size: 1rem; }
    dd span { font-size: 0.8rem; }
    .principles, .interests { grid-template-columns: 1fr; }
    .principle { grid-template-columns: 28px minmax(0, 1fr); gap: 12px 16px; padding-top: 22px; }
    .principle-number { padding-top: 2px; }
    .principle p { grid-column: 2; }
    .focus-heading { margin-bottom: 28px; }
    .interest-top { margin-bottom: 22px; }
    .next-step { flex-direction: column; align-items: start; margin-top: 32px; }
  }
</style>
