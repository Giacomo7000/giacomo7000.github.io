---
import GMLogo from "./GMLogo.astro";
import { site } from "@data/site";
import type { Lang } from "@data/site";
import { localizedPath, t } from "@lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const cvHref = site.cvPath[lang];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <GMLogo size={30} />
      <span>{site.name}</span>
    </div>
    <p>{site.tagline[lang]}</p>
    <div class="footer-links">
      <div class="footer-professional">
        <a class="footer-icon-link" href={`mailto:${site.email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 6h16v12H4z"></path>
            <path d="m4 7 8 6 8-6"></path>
          </svg>
          <span>Email</span>
        </a>
        <a class="footer-icon-link" href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 10v10"></path>
            <path d="M4 4.5v.01"></path>
            <path d="M10 20v-6.2c0-2.1 1.2-3.4 3-3.4s3 1.3 3 3.4V20"></path>
            <path d="M10 10v10"></path>
            <path d="M20 20v-6.8c0-4.1-2.2-6.2-5.2-6.2-2 0-3.3 1-4 2"></path>
          </svg>
          <span>LinkedIn</span>
        </a>
        <a href={cvHref}>CV</a>
      </div>
      <div class="footer-reading">
        <span class="footer-separator" aria-hidden="true">|</span>
        <a href={localizedPath(lang, "/reading")}>{t(lang, "reading")}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 34px 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 32px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-brand,
  .footer-links,
  .footer-professional,
  .footer-reading {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-brand {
    color: var(--text);
    font-weight: 800;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 750;
    min-height: 44px;
  }

  .footer-links {
    grid-column: 2;
    grid-row: 1 / span 2;
    flex-wrap: wrap;
  }

  .footer-brand,
  .footer-inner > p { grid-column: 1; }

  .footer-inner > p { max-width: 60ch; }

  .footer-professional { flex-wrap: wrap; }

  .footer-reading { flex-shrink: 0; }

  .footer-separator { color: var(--muted); font-weight: 400; }

  .footer-icon-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 1000px) {
    .footer-inner {
      grid-template-columns: 1fr;
      row-gap: 14px;
    }

    .footer-links { grid-column: 1; grid-row: auto; }
  }
</style>
